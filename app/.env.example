# Copy this file to .env for local development (Railway: set these as
# Variables in the service settings instead -- .env is not used there).
# Never commit a real .env file -- it's already in .gitignore.

# --- Core app mode ---
# true = hosted SaaS (login required, 3-proposal trial, bundled AI, Stripe).
# false = original single-user local prototype behaviour (no login, BYO AI key).
SAAS_MODE=true

# Long random string used to sign session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing this logs every user out (their cookie stops verifying) -- set it
# once on Railway and leave it alone.
APP_SECRET_KEY=change-me-to-a-long-random-string

# Public URL of the deployed app (used to build Stripe success/cancel/portal
# redirect URLs). Set to your app subdomain once DNS is connected, e.g.
# https://app.civilproposals.com -- until then Railway's own
# *.up.railway.app URL works fine.
APP_BASE_URL=https://app.civilproposals.com

# --- Database (Railway sets this automatically when you attach a Postgres
# plugin to this service -- you shouldn't need to set it by hand there) ---
# DATABASE_URL=postgresql://user:password@host:port/dbname

# --- Bundled AI provider (server-side key -- billed to you, not the user) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Stripe ---
# Secret key from the Stripe dashboard (Developers -> API keys). Use a
# test-mode key (sk_test_...) until step 15 (Go live), then swap for the
# live key (sk_live_...).
STRIPE_SECRET_KEY=sk_test_...
# The Price ID (not Product ID) for the $200/month subscription -- Stripe
# dashboard -> Product catalog -> your product -> the price's "API ID",
# looks like price_1AbCdEfGhIjKlMnOp. Create a new Price (don't edit this
# one) if you ever need to change the amount, then update this value.
STRIPE_PRICE_ID=price_...

# The Price ID for the $50 one-time pay-as-you-go bid -- same dashboard
# location as above, but for a ONE-TIME (not recurring) Price.
STRIPE_BID_PRICE_ID=price_...

# --- Email (Resend, used only for "forgot password" reset links -- see
# modules/email_utils.py) ---
# API key from resend.com (Settings -> API Keys), starts with re_. Until
# both this AND RESEND_FROM_EMAIL below are set, "Forgot password?" shows a
# clear "not set up yet" message instead of silently failing.
RESEND_API_KEY=re_...
# Must be an address on a domain you've added and VERIFIED in Resend (DNS
# records added at your registrar -- Cloudflare, for civilproposals.com).
RESEND_FROM_EMAIL=CivilProposals <noreply@civilproposals.com>
