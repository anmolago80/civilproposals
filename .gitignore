# Never commit the real .env (API keys) anywhere in this repo.
.env
*.env
!.env.example

# Local databases
*.db

# One-off fix bundles and scratch notes -- keep these out of the deployed repo.
*.zip
*.bak
push_commands*.txt

# Local scratch/recycle area (files awaiting manual deletion on Windows).
_to_delete/

# Wrangler's machine-local cache/state -- never repo content.
.wrangler/

__pycache__/
*.pyc
venv/
modules/pages/__pycache__/
