<?xml version="1.0" encoding="UTF-8"?>
<!-- FALLBACK ONLY. Once the blog has been published even once, _worker.js
     serves a generated sitemap from KV instead of this file -- it has to,
     because posts appear and disappear without a redeploy, and a static
     file can't track them. This copy is what's served before that first
     publish. See app/modules/blog.py's render_sitemap_xml().

     terms-of-service.html, privacy-policy.html and cookie-policy.html are
     all left out on purpose -- they carry <meta name="robots" content=
     "noindex"> (legal boilerplate, not content anyone should land on from
     search), and listing noindex pages in a sitemap is a known anti-pattern
     that just generates "Submitted URL marked noindex" warnings in Search
     Console. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://civilproposals.com/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
<!-- /blog/ is deliberately absent from THIS fallback copy: before the first
     post is published, that address serves landing/blog/index.html, which
     is a noindex placeholder, and listing a noindex URL here is the exact
     anti-pattern described above. The generated sitemap that replaces this
     file at first publish does include /blog/, because by then it's a real
     listing with real content. -->
  <url>
    <loc>https://civilproposals.com/security.html</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
</urlset>
